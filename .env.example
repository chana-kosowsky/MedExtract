# להעתיק ל-.env ולמלא. אין לשים ערכים אמיתיים בקובץ הזה.

# מסד הנתונים: PostgreSQL ב-Supabase (Session pooler), לדוגמה:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# מפתחות לספקי המודלים
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# שרשרת המודלים (החלטה 34): "ספק:מודל" מופרדים בפסיק, הראשון ראשי והשאר גיבויים לפי הסדר.
# ספקים: anthropic, gemini. לאמת את שמות המודלים מול התיעוד של הספק. לדוגמה:
# MODEL_CHAIN=anthropic:claude-opus-5-5, gemini:gemini-3.8-flash, gemini:gemini-3.5-flash-lite
MODEL_CHAIN=

# בלי MODEL_CHAIN: Gemini בלבד, עם המודל הזה. משמש גם כברירת מחדל בהערכה (eval/evaluate.py)
GEMINI_MODEL=
# ברירת המחדל של --provider anthropic בהערכה
ANTHROPIC_MODEL=

# כניסה למערכת: משתמש אחד. ריק = בלי מסך כניסה (פיתוח מקומי)
LOGIN_USER=
LOGIN_PASSWORD=
# true = מסך הכניסה מציג את שם המשתמש והסיסמה (לדמו הציבורי בלבד)
LOGIN_SHOW_DEMO=
# מפתח לחתימת עוגיית הכניסה: מחרוזת אקראית ארוכה. ריק = מפתח חדש בכל הפעלה (הכניסות מתאפסות)
SESSION_SECRET=

# אופציונלי: רזולוציית קריאת התמונה ב-Gemini (low / medium / high). ריק = ברירת המחדל של Google
GEMINI_MEDIA_RESOLUTION=
